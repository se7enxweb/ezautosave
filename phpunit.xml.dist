<?xml version="1.0" encoding="UTF-8"?>
<!--
  The ezautosave unit tests that need no database, no request and no kernel.
  Run from this directory: phpunit (any PHPUnit 10 or later, e.g. the installation's vendor/bin/phpunit).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         colors="false"
         cacheDirectory="var/phpunit"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
